第二主题：植物生长实验（原型机制冻结，迁移学习-预测测试）
网络 26 神经元（条件 20 + 结果 6），参数与小球原型完全相同
课程：6 组控制变量实验；查询：64 个

── 完整模型（G=3，退火读出，查询参与学习） ──
  组 species-group      变化候选=[species] → 影响因素=[]
  组 light-group        变化候选=[light] → 影响因素=[light(m=0.22)]
  组 water-group        变化候选=[water] → 影响因素=[water(m=0.25)]
  组 fertilizer-group   变化候选=[fertilizer] → 影响因素=[fertilizer(m=0.33)]
  组 temperature-group  变化候选=[temperature] → 影响因素=[temperature(m=0.17)]
  组 pest-group         变化候选=[pest] → 影响因素=[pest(m=0.92)]
  seen-combo      细粒度  15/24（62.5%）  粗粒度存活 100.0%  错 9  歧义 0
  unseen-species  细粒度   9/24（37.5%）  粗粒度存活 100.0%  错 15  歧义 0
  unseen-combo    细粒度  27/48（56.3%）  粗粒度存活 100.0%  错 21  歧义 0
  pest-control    细粒度  96/96（100.0%）  粗粒度存活 100.0%  错 0  歧义 0
  总计：细粒度 147/192（76.6%），粗粒度存活 100.0%
  失败样例（seed 首个，至多 10 条）：
    [seen-combo] {"species":0,"light":0,"water":1,"fertilizer":1,"temperature":1,"pest":0} → {"alive":1,"growth":3}（真值 {"alive":1,"growth":1}）
    [unseen-species] {"species":3,"light":0,"water":1,"fertilizer":1,"temperature":1,"pest":0} → {"alive":1,"growth":3}（真值 {"alive":1,"growth":1}）
    [unseen-combo] {"species":0,"light":0,"water":2,"fertilizer":1,"temperature":1,"pest":0} → {"alive":1,"growth":3}（真值 {"alive":1,"growth":2}）
    [unseen-combo] {"species":3,"light":0,"water":2,"fertilizer":1,"temperature":1,"pest":0} → {"alive":1,"growth":3}（真值 {"alive":1,"growth":2}）
    [unseen-combo] {"species":0,"light":0,"water":3,"fertilizer":1,"temperature":1,"pest":0} → {"alive":1,"growth":3}（真值 {"alive":1,"growth":2}）
    [unseen-combo] {"species":3,"light":0,"water":3,"fertilizer":1,"temperature":1,"pest":0} → {"alive":1,"growth":3}（真值 {"alive":1,"growth":2}）
    [seen-combo] {"species":0,"light":1,"water":0,"fertilizer":1,"temperature":1,"pest":0} → {"alive":1,"growth":2}（真值 {"alive":1,"growth":1}）
    [unseen-species] {"species":3,"light":1,"water":0,"fertilizer":1,"temperature":1,"pest":0} → {"alive":1,"growth":3}（真值 {"alive":1,"growth":1}）
    [unseen-species] {"species":3,"light":1,"water":1,"fertilizer":1,"temperature":1,"pest":0} → {"alive":1,"growth":3}（真值 {"alive":1,"growth":2}）
    [unseen-species] {"species":3,"light":1,"water":2,"fertilizer":1,"temperature":1,"pest":0} → {"alive":1,"growth":3}（真值 {"alive":1,"growth":2}）

